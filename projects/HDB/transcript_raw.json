}, {"start": 16.24, "end": 20.18, "text": " baik ah rituan, baik ah rituan, iaitu berlaku di bawah", "words": [{"w": " baik", "s": 16.24, "e": 16.62}, {"w": " ah", "s": 16.62, "e": 16.84}, {"w": " rituan,", "s": 16.84, "e": 17.3}, {"w": " baik", "s": 17.52, "e": 17.98}, {"w": " ah", "s": 17.98, "e": 18.28}, {"w": " rituan,", "s": 18.28, "e": 18.84}, {"w": " iaitu", "s": 18.84, "e": 19.4}, {"w": " berlaku", "s": 19.4, "e": 19.8}, {"w": " di", "s": 19.8, "e": 19.98}, {"w": " bawah", "s": 19.98, "e": 20.18}]}, {"start": 20.18, "end": 22.94, "text": " sepuluh pokok. Adakah berlaku di sini? Allah", "words": [{"w": " sepuluh", "s": 20.18, "e": 20.52}, {"w": " pokok.", "s": 20.52, "e": 20.8}, {"w": " Adakah", "s": 21.12, "e": 21.46}, {"w": " berlaku", "s": 21.46, "e": 21.84}, {"w": " di", "s": 21.84, "e": 21.98}, {"w": " sini?", "s": 21.98, "e": 22.28}, {"w": " Allah", "s": 22.74, "e": 22.94}]}, {"start": 22.94, "end": 26.36, "text": " alam mubisawab. Saya pun tak tahu dekat mana. Tapi", "words": [{"w": " alam", "s": 22.94, "e": 23.56}, {"w": " mubisawab.", "s": 23.56, "e": 24.12}, {"w": " Saya", "s": 24.24, "e": 24.4}, {"w": " pun", "s": 24.4, "e": 24.6}, {"w": " tak", "s": 24.6, "e": 24.76}, {"w": " tahu", "s": 24.76, "e": 25.08}, {"w": " dekat", "s": 25.08, "e": 25.64}, {"w": " mana.", "s": 25.64, "e": 25.84}, {"w": " Tapi", "s": 26.12, "e": 26.36}]}, {"start": 26.36, "end": 30.36, "text": " macam usaha Enol cerita kan tadi apabila pada zaman", "words": [{"w": " macam", "s": 26.36, "e": 26.66}, {"w": " usaha", "s": 26.66, "e": 27.08}, {"w": " Enol", "s": 27.08, "e": 27.32}, {"w": " cerita", "s": 27.32, "e": 27.66}, {"w": " kan", "s": 27.66, "e": 27.82}, {"w": " tadi", "s": 27.82, "e": 28.12}, {"w": " apabila", "s": 28.12, "e": 29.42}, {"w": " pada", "s": 29.42, "e": 29.82}, {"w": " zaman", "s": 29.82, "e": 30.36}]}, {"start": 30.36, "end": 34.58, "text": " kalifah saya dengar umar ibu nak katap, pohon tu", "words": [{"w": " kalifah", "s": 30.36, "e": 31.26}, {"w": " say