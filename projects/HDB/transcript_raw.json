 {"w": " dan", "s": 50.62, "e": 51.42}, {"w": " jadi", "s": 51.42, "e": 51.58}, {"w": " kalifah", "s": 51.58, "e": 51.96}]}, {"start": 51.96, "end": 56.0, "text": " yang kedua pohon tu masih ada dan berlaku lah ketika", "words": [{"w": " yang", "s": 51.96, "e": 52.06}, {"w": " kedua", "s": 52.06, "e": 52.36}, {"w": " pohon", "s": 52.36, "e": 53.3}, {"w": " tu", "s": 53.3, "e": 53.44}, {"w": " masih", "s": 53.44, "e": 53.62}, {"w": " ada", "s": 53.62, "e": 53.88}, {"w": " dan", "s": 53.88, "e": 54.7}, {"w": " berlaku", "s": 54.7, "e": 55.34}, {"w": " lah", "s": 55.34, "e": 55.62}, {"w": " ketika", "s": 55.62, "e": 56.0}]}, {"start": 56.0, "end": 61.34, "text": " itu umat Islam ada berlaku sikit kesirikan. Yaitu dia", "words": [{"w": " itu", "s": 56.0, "e": 56.34}, {"w": " umat", "s": 56.34, "e": 56.8}, {"w": " Islam", "s": 56.8, "e": 57.14}, {"w": " ada", "s": 57.14, "e": 57.9}, {"w": " berlaku", "s": 57.9, "e": 58.38}, {"w": " sikit", "s": 58.38, "e": 59.0}, {"w": " kesirikan.", "s": 59.0, "e": 60.06}, {"w": " Yaitu", "s": 60.56, "e": 61.2}, {"w": " dia", "s": 61.2, "e": 61.34}]}, {"start": 61.34, "end": 64.62, "text": " pergi dekat pohon tersebut kan dia buat macam satu ambil", "words": [{"w": " pergi", "s": 61.34, "e": 61.6}, {"w": " dekat", "s": 61.6, "e": 61.9}, {"w": " pohon", "s": 61.9, "e": 62.2}, {"w": " tersebut", "s": 62.2, "e": 62.62}, {"w": " kan", "s": 62.62, "e": 63.0}, {"w": " dia", "s": 63.0, "e": 63.5}, {"w": " buat", "s": 63.5, "e": 63.62}, {"w": " macam", "s": 63.62, "e": 63.88}, {"w": " satu", "s": 63.88, "e": 64.24}, {"w": " ambil", "s": 64.24, "e": 64.62}]}, {"start": 64.62, "end": 68.18, "text": " bermujaan lah lebih kurang katanya begitu. Apabila dapat", "words": [{"w": " bermujaan", "s": 64.62, "e": 65.46}, {"w": " lah", "s": 65.46, "e": 65.56}, {"w": " lebih", "s": 65.56, "e": 65.76}, {"w": " kurang", "s": 65.76, "e": 66.08}, {"w": " katanya", "s": 66.08, "e": 66.4}, {"w": " begitu.", "s": 66.4, "e": 66.72}, {"w": " Apabila", "s": 67.28, "e": 67.92}, {"w": " dapat", "s": 67.92, "e": 68.18}]}, {"start": 68.18, "end": 71.48, "text": " tahu oleh Sadina Umar ibu nak katap, maka Sadina Umar", "words": [{"w": " tahu", "s": 68.18, "e": 68.5}, {"w": " oleh", "s": 68.5, "e": 68.78}, {"w": " Sadina", "s": 68.78, "e": 69.1}, {"w": " Umar", "s": 69.1, "e": 69.46}, {"w": " ibu", "s": 69.46, "e": 69.6}, {"w": " nak", "s": 69.6, "e": 69.72}, {"w": " katap,", "s": 69.72, "e": 70.22}, {"w": " maka", "s": 70.3, "e": 70.86}, {"w": " Sadina", "s": 70.86, "e": 71.2}, {"w": " Umar", "s": 71.2, "e": 71.48}]}, {"start": 71.48, "end": 74.72, "text": " dia buat apa? Dia tepang pokok tersebut. Dan sebab kita", "words": [{"w": " dia", "s": 71.48, "e": 71.56}, {"w": " buat", "s": 71.56, "e": 71.66}, {"w": " apa?", "s": 71.66, "e": 71.86}, {"w": " Dia", "s": 72.28, "e": 72.5}, {"w": " tepang", "s": 72.5, "e": 72.72}, {"w": " pokok", "s": 72.72, "e": 73.0}, {"w": " tersebut.", "s": 73.0, "e": 73.36}, {"w": " Dan", "s": 73.66, "e": 74.28}, {"w": " sebab", "s": 74.28, "e": 74.48}, {"w": " kita", "s": 74.48, "e": 74.72}]}, {"start": 74.72, "end": 79.42, "text": " tahu Sadina Umar ni adalah insan yang tegas. Okey? Macam", "words": [{"w": " tahu", "s": 74.72, "e": 75.04}, {"w": " Sadina", "s": 75.04, "e": 75.52}, {"w": " Umar", "s": 75.52, "e": 75.86}, {"w": " ni", "s": 75.86, "e": 76.0}, {"w": " adalah", "s": 76.0, "e": 76.56}, {"w": " insan", "s": 76.56, "e": 77.1}, {"w": " yang", "s": 77.1, "e": 77.4}, {"w": " tegas.", "s": 77.4, "e": 77.88}, {"w": " Okey?", "s": 78.2, "e": 78.84}, {"w": " Macam", "s": 79.18, "e": 79.42}]}, {"start": 79.42, "end": 84.28, "text": " usaha katakan tadi pada awal ni untuk bagi", "words": [{"w": " usaha", "s": 79.42, "e": 79.64}, {"w": " katakan", "s": 79.64, "e": 80.14}, {"w": " tadi", "s": 80.14, "e": 80.38}, {"w": " pada", "s": 80.38, "e": 80.92}, {"w": " awal", "s": 80.92, "e": 81.58}, {"w": " ni", "s": 81.58, "e": 81.72}, {"w": " untuk", "s": 81.72, "e": 82.94}, {"w": " bagi", "s": 82.94, "e": 84.28}]}, {"start": 84.28, "end": 90.2, "text": " baginda saka-saka nak hantar sahabat untuk berundi dengan", "words": [{"w": " baginda", "s": 84.28, "e": 85.24}, {"w": " saka", "s": 85.24, "e": 85.4}, {"w": "-saka", "s": 85.4, "e": 85.6}, {"w": " nak", "s": 85.6, "e": 85.8}, {"w": " hantar", "s": 85.8, "e": 86.58}, {"w": " sahabat", "s": 86.58, "e": 87.84}, {"w": " untuk", "s": 87.84, "e": 88.38}, {"w": " berundi", "s": 88.38, "e": 89.94}, {"w": " dengan", "s": 89.94, "e": 90.2}]}, {"start": 90.2, "end": 93.76, "text": " kawm kurash dia yang berada di meka pada awalnya Nabi pilih", "words": [{"w": " kawm", "s": 90.2, "e": 90.76}, {"w": " kurash", "s": 90.76, "e": 91.1}, {"w": " dia", "s": 91.1, "e": 91.3}, {"w": " yang", "s": 91.3, "e": 91.44}, {"w": " berada", "s": 91.44, "e": 91.64}, {"w": " di", "s": 91.64, "e": 91.78}, {"w": " meka", "s": 91.78, "e": 92.06}, {"w": " pada", "s": 92.06, "e": 92.36}, {"w": " awalnya", "s": 92.36, "e": 92.74}, {"w": " Nabi", "s": 92.74, "e": 93.3}, {"w": " pilih", "s": 93.3, "e": 93.76}]}, {"start": 93.76, "end": 96.96, "text": " Sadina Umar. Tapi Sadina Umar cakap apa? Sadina Umar", "words": [{"w": " Sadina", "s": 93.76, "e": 94.02}, {"w": " Umar.", "s": 94.02, "e": 94.36}, {"w": " Tapi", "s": 94.72, "e": 95.26}, {"w": " Sadina", "s": 95.26, "e": 95.48}, {"w": " Umar", "s": 95.48, "e": 95.68}, {"w": " cakap", "s": 95.68, "e": 95.9}, {"w": " apa?", "s": 95.9, "e": 96.14}, {"w": " Sadina", "s": 96.52, "e": 96.8}, {"w": " Umar", "s": 96.8, "e": 96.96}]}, {"start": 96.96, "end": 100.64, "text": " cakap wajr Rasulullah kalau kau hantar aku dia tak jadi", "words": [{"w": " cakap", "s": 96.96, "e": 97.26}, {"w": " wajr", "s": 97.26, "e": 97.96}, {"w": " Rasulullah", "s": 97.96, "e": 98.4}, {"w": " kalau", "s": 98.4, "e": 98.96}, {"w": " kau", "s": 98.96, "e": 99.16}, {"w": " hantar", "s": 99.16, "e": 99.46}, {"w": " aku", "s": 99.46, "e": 99.7}, {"w": " dia", "s": 99.7, "e": 100.26}, {"w": " tak", "s": 100.26, "e": 100.4}, {"w": " jadi", "s": 