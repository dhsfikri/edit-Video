                          470.0,
                          -80.0,
                          0.0
                        ]
                      },
                      "expr": {
                        "text": "var h=thisComp.layer(\"Tangan\");\nfunction bo(p){var n=7.5625,d=2.75;if(p<1/d)return n*p*p;if(p<2/d){p-=1.5/d;return n*p*p+.75;}if(p<2.5/d){p-=2.25/d;return n*p*p+.9375;}p-=2.625/d;return n*p*p+.984375;}\nvar t=time;var fy=-80+600*bo(Math.min(1,Math.max(0,(t-1.25)/0.55)));\nvar hp=h.toComp(h.transform.anchorPoint);\nif(t<3.9){var w=Math.min(1,Math.max(0,(t-1.98)/0.18));w=w*w*(3-2*w);[470+(hp[0]-470)*w,fy+(hp[1]-fy)*w,0];}\nelse{var r=h.toComp(h.transform.anchorPoint,3.9);var L=r[1]+30;var a0=Math.atan2(r[0]-470,L);var s=t-3.9;var a=(a0-0.32)*Math.exp(-3*s)*Math.cos(9*s);[470+Math.sin(a)*L,-30+Math.cos(a)*L,0];}",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Point"
                      },
                      "spatial": true,
                      "hold_only": false,
